<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Balancete — controle financeiro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#EAE4D3;
    --paper-dim:#E1D8C2;
    --card:#F3EDDE;
    --ink:#23291F;
    --ink-soft:#5B6353;
    --line:#C3B896;
    --gold:#B8912E;
    --brick:#9A4331;
    --forest:#33604A;
    --shadow:rgba(35,41,31,0.16);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      repeating-linear-gradient(180deg, transparent, transparent 33px, var(--line) 34px) ,
      var(--paper);
    background-attachment:local;
    color:var(--ink);
    font-family:'Inter',sans-serif;
    min-height:100vh;
  }
  ::selection{background:var(--gold); color:var(--paper);}

  .app{
    display:flex;
    max-width:1100px;
    margin:0 auto;
    min-height:100vh;
  }

  /* ---- lombada / spine ---- */
  .spine{
    width:64px;
    flex:0 0 64px;
    background:var(--ink);
    background-image: repeating-linear-gradient(180deg, rgba(255,255,255,.05) 0 2px, transparent 2px 18px);
    position:relative;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:28px 0;
  }
  .spine::after{
    content:"";
    position:absolute;
    top:0; right:-6px;
    width:6px; height:100%;
    background:linear-gradient(90deg, rgba(0,0,0,.25), transparent);
  }
  .spine-title{
    writing-mode:vertical-rl;
    text-orientation:mixed;
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:14px;
    letter-spacing:.12em;
    color:var(--paper-dim);
    margin-bottom:24px;
  }
  .stitches{
    flex:1;
    width:2px;
    background-image: linear-gradient(var(--gold) 60%, transparent 0);
    background-size: 2px 10px;
    background-repeat:repeat-y;
    opacity:.55;
  }

  /* ---- main ---- */
  main{
    flex:1;
    padding:32px clamp(16px, 4vw, 48px) 64px;
    min-width:0;
  }

  header.top{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:8px;
  }
  header.top h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(28px,4vw,38px);
    margin:0;
    letter-spacing:-.01em;
  }
  header.top .sub{
    font-size:13px;
    color:var(--ink-soft);
    font-style:italic;
  }

  /* month tabs */
  .tabs{
    display:flex;
    gap:6px;
    flex-wrap:wrap;
    margin:20px 0 28px;
    border-bottom:1px solid var(--line);
    padding-bottom:14px;
  }
  .tab{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    padding:6px 12px;
    border:1px solid var(--line);
    border-radius:3px 3px 0 0;
    background:var(--card);
    color:var(--ink-soft);
    cursor:pointer;
    text-transform:capitalize;
  }
  .tab.active{
    background:var(--ink);
    color:var(--paper);
    border-color:var(--ink);
  }

  /* stamp + tiles */
  .top-row{
    display:flex;
    gap:28px;
    align-items:center;
    flex-wrap:wrap;
    margin-bottom:32px;
  }
  .stamp{
    width:132px; height:132px;
    flex:0 0 132px;
    border-radius:50%;
    border:3px double var(--brick);
    color:var(--brick);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    transform:rotate(-7deg);
    text-align:center;
    padding:8px;
    animation:stamp-press .35s ease-out;
  }
  .stamp.positive{ border-color:var(--forest); color:var(--forest); }
  @keyframes stamp-press{
    0%{ transform:rotate(-7deg) scale(1.4); opacity:0; }
    100%{ transform:rotate(-7deg) scale(1); opacity:1; }
  }
  .stamp .label{
    font-size:9.5px;
    letter-spacing:.14em;
    text-transform:uppercase;
    font-family:'Inter',sans-serif;
    font-weight:600;
  }
  .stamp .value{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:19px;
    line-height:1.15;
    margin-top:4px;
  }

  .tiles{
    display:flex;
    gap:16px;
    flex:1;
    min-width:220px;
  }
  .tile{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:4px;
    padding:14px 16px;
    flex:1;
    min-width:130px;
  }
  .tile .label{
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.08em;
    color:var(--ink-soft);
  }
  .tile .value{
    font-family:'IBM Plex Mono', monospace;
    font-size:20px;
    font-weight:600;
    margin-top:4px;
  }
  .tile.in .value{ color:var(--forest); }
  .tile.out .value{ color:var(--brick); }

  /* chart */
  section.block{ margin-bottom:36px; }
  h2.block-title{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:15px;
    letter-spacing:.03em;
    text-transform:uppercase;
    color:var(--ink-soft);
    margin:0 0 14px;
    display:flex;
    align-items:center;
    gap:10px;
  }
  h2.block-title::after{
    content:"";
    flex:1;
    height:1px;
    background:var(--line);
  }
  .bar-row{
    display:grid;
    grid-template-columns:110px 1fr 84px;
    align-items:center;
    gap:10px;
    margin-bottom:9px;
    font-size:12.5px;
  }
  .bar-row .cat{ color:var(--ink-soft); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .bar-track{
    height:9px;
    background:var(--paper-dim);
    border-radius:2px;
    overflow:hidden;
  }
  .bar-fill{ height:100%; background:var(--brick); border-radius:2px; }
  .bar-row .amt{ font-family:'IBM Plex Mono', monospace; text-align:right; }
  .empty-note{ color:var(--ink-soft); font-size:13px; font-style:italic; }

  /* ledger table */
  .ledger{ width:100%; border-collapse:collapse; font-size:13.5px; }
  .ledger thead th{
    text-align:left;
    font-size:10.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-soft);
    border-bottom:1px solid var(--ink);
    padding:0 8px 8px;
    font-weight:600;
  }
  .ledger tbody td{
    padding:9px 8px;
    border-bottom:1px dashed var(--line);
    vertical-align:top;
  }
  .ledger tbody tr:hover{ background:rgba(184,145,46,0.08); }
  .ledger .num{ font-family:'IBM Plex Mono', monospace; text-align:right; white-space:nowrap; }
  .ledger .in{ color:var(--forest); }
  .ledger .out{ color:var(--brick); }
  .ledger .cat-pill{
    font-size:10.5px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:10px;
    padding:1px 8px;
    color:var(--ink-soft);
  }
  .del-btn{
    background:none; border:none; cursor:pointer;
    color:var(--ink-soft); font-size:14px;
    padding:2px 4px;
  }
  .del-btn:hover{ color:var(--brick); }

  /* form */
  .entry-form{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:6px;
    padding:20px;
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr 1fr auto;
    gap:12px;
    align-items:end;
  }
  @media (max-width:760px){
    .entry-form{ grid-template-columns:1fr 1fr; }
    .top-row{ flex-direction:column; align-items:flex-start; }
  }
  .field label{
    display:block;
    font-size:10.5px;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--ink-soft);
    margin-bottom:5px;
  }
  .field input, .field select{
    width:100%;
    font:inherit;
    font-size:13.5px;
    padding:8px 9px;
    border:1px solid var(--line);
    border-radius:3px;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter', sans-serif;
  }
  .type-toggle{ display:flex; gap:6px; }
  .type-toggle button{
    flex:1;
    padding:8px 6px;
    border:1px solid var(--line);
    background:var(--paper);
    color:var(--ink-soft);
    font-size:12.5px;
    cursor:pointer;
    border-radius:3px;
    font-family:'Inter', sans-serif;
    font-weight:600;
  }
  .type-toggle button.active[data-type="in"]{ background:var(--forest); color:#fff; border-color:var(--forest); }
  .type-toggle button.active[data-type="out"]{ background:var(--brick); color:#fff; border-color:var(--brick); }

  .submit-btn{
    padding:9px 18px;
    background:var(--ink);
    color:var(--paper);
    border:none;
    border-radius:3px;
    font-weight:600;
    font-size:13px;
    cursor:pointer;
    font-family:'Inter',sans-serif;
    white-space:nowrap;
  }
  .submit-btn:hover{ background:#000; }

  .backup-row{
    margin-top:40px;
    display:flex;
    gap:10px;
    align-items:center;
    font-size:12px;
    color:var(--ink-soft);
  }
  .ghost-btn{
    background:none;
    border:1px solid var(--line);
    color:var(--ink-soft);
    padding:6px 12px;
    border-radius:3px;
    cursor:pointer;
    font-size:12px;
    font-family:'Inter',sans-serif;
  }
  .ghost-btn:hover{ border-color:var(--ink); color:var(--ink); }
  #importFile{ display:none; }
</style>
</head>
<body>
<div class="app">
  <div class="spine">
    <div class="spine-title">BALANCETE</div>
    <div class="stitches"></div>
  </div>

  <main>
    <header class="top">
      <h1>Balancete</h1>
      <div class="sub">seu livro-caixa pessoal</div>
    </header>

    <div class="tabs" id="tabs"></div>

    <div class="top-row">
      <div class="stamp" id="stamp">
        <div class="label">Saldo</div>
        <div class="value" id="stampValue">R$ 0,00</div>
      </div>
      <div class="tiles">
        <div class="tile in">
          <div class="label">Entradas</div>
          <div class="value" id="tileIn">R$ 0,00</div>
        </div>
        <div class="tile out">
          <div class="label">Saídas</div>
          <div class="value" id="tileOut">R$ 0,00</div>
        </div>
      </div>
    </div>

    <section class="block">
      <h2 class="block-title">Novo lançamento</h2>
      <form class="entry-form" id="entryForm">
        <div class="field">
          <label>Descrição</label>
          <input type="text" id="fDesc" placeholder="Ex: Mercado, salário..." required>
        </div>
        <div class="field">
          <label>Valor (R$)</label>
          <input type="number" id="fAmount" step="0.01" min="0.01" placeholder="0,00" required>
        </div>
        <div class="field">
          <label>Categoria</label>
          <select id="fCategory"></select>
        </div>
        <div class="field">
          <label>Data</label>
          <input type="date" id="fDate" required>
        </div>
        <div class="field">
          <label>Tipo</label>
          <div class="type-toggle">
            <button type="button" data-type="out" class="active">Saída</button>
            <button type="button" data-type="in">Entrada</button>
          </div>
        </div>
        <div class="field" style="grid-column:-2/-1; align-self:end;">
          <button type="submit" class="submit-btn">Lançar</button>
        </div>
      </form>
    </section>

    <section class="block">
      <h2 class="block-title">Despesas por categoria</h2>
      <div id="chart"></div>
    </section>

    <section class="block">
      <h2 class="block-title">Lançamentos</h2>
      <table class="ledger">
        <thead>
          <tr>
            <th>Data</th>
            <th>Descrição</th>
            <th>Categoria</th>
            <th style="text-align:right;">Valor</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="ledgerBody"></tbody>
      </table>
    </section>

    <div class="backup-row">
      <button class="ghost-btn" id="exportBtn">Exportar backup (.json)</button>
      <button class="ghost-btn" id="importBtn">Importar backup</button>
      <input type="file" id="importFile" accept="application/json">
    </div>
  </main>
</div>

<script>
(function(){
  const STORAGE_KEY = 'balancete:transactions';
  const DEFAULT_CATEGORIES = ['Alimentação','Transporte','Moradia','Lazer','Saúde','Educação','Salário','Outros'];

  let transactions = loadData();
  let selectedMonth = 'all'; // 'all' or 'YYYY-MM'

  const brl = new Intl.NumberFormat('pt-BR', { style:'currency', currency:'BRL' });

  function loadData(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    }catch(e){
      console.error('Erro ao carregar dados', e);
      return [];
    }
  }

  function saveData(){
    localStorage.setItem(STORAGE_KEY, JSON.stringify(transactions));
  }

  function monthKey(dateStr){
    return dateStr.slice(0,7); // YYYY-MM
  }

  function monthLabel(key){
    if(key === 'all') return 'Todos';
    const [y,m] = key.split('-');
    const d = new Date(Number(y), Number(m)-1, 1);
    return d.toLocaleDateString('pt-BR', { month:'short', year:'2-digit' }).replace('.','');
  }

  function populateCategorySelect(){
    const sel = document.getElementById('fCategory');
    sel.innerHTML = '';
    DEFAULT_CATEGORIES.forEach(cat=>{
      const opt = document.createElement('option');
      opt.value = cat; opt.textContent = cat;
      sel.appendChild(opt);
    });
  }

  function renderTabs(){
    const keys = Array.from(new Set(transactions.map(t=>monthKey(t.date)))).sort().reverse();
    const currentMonth = new Date().toISOString().slice(0,7);
    if(!keys.includes(currentMonth)) keys.unshift(currentMonth);
    const allKeys = ['all', ...keys];

    const wrap = document.getElementById('tabs');
    wrap.innerHTML = '';
    allKeys.forEach(k=>{
      const b = document.createElement('div');
      b.className = 'tab' + (k===selectedMonth ? ' active' : '');
      b.textContent = monthLabel(k);
      b.addEventListener('click', ()=>{ selectedMonth = k; renderAll(); });
      wrap.appendChild(b);
    });
  }

  function filteredTransactions(){
    if(selectedMonth === 'all') return transactions;
    return transactions.filter(t=>monthKey(t.date) === selectedMonth);
  }

  function renderSummary(list){
    const income = list.filter(t=>t.type==='in').reduce((s,t)=>s+t.amount,0);
    const expense = list.filter(t=>t.type==='out').reduce((s,t)=>s+t.amount,0);
    const balance = income - expense;

    document.getElementById('tileIn').textContent = brl.format(income);
    document.getElementById('tileOut').textContent = brl.format(expense);

    const stamp = document.getElementById('stamp');
    stamp.classList.toggle('positive', balance >= 0);
    document.getElementById('stampValue').textContent = brl.format(balance);
  }

  function renderChart(list){
    const totals = {};
    list.filter(t=>t.type==='out').forEach(t=>{
      totals[t.category] = (totals[t.category]||0) + t.amount;
    });
    const entries = Object.entries(totals).sort((a,b)=>b[1]-a[1]);
    const chart = document.getElementById('chart');
    chart.innerHTML = '';
    if(entries.length === 0){
      chart.innerHTML = '<div class="empty-note">Nenhuma despesa registrada neste período.</div>';
      return;
    }
    const max = entries[0][1];
    entries.forEach(([cat, val])=>{
      const row = document.createElement('div');
      row.className = 'bar-row';
      row.innerHTML = `
        <div class="cat">${cat}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(val/max*100).toFixed(1)}%"></div></div>
        <div class="amt">${brl.format(val)}</div>
      `;
      chart.appendChild(row);
    });
  }

  function renderLedger(list){
    const body = document.getElementById('ledgerBody');
    body.innerHTML = '';
    const sorted = [...list].sort((a,b)=> b.date.localeCompare(a.date));
    if(sorted.length === 0){
      body.innerHTML = '<tr><td colspan="5" class="empty-note" style="padding:16px 8px;">O balancete está em branco para este período. Registre seu primeiro lançamento acima.</td></tr>';
      return;
    }
    sorted.forEach(t=>{
      const tr = document.createElement('tr');
      const [y,m,d] = t.date.split('-');
      tr.innerHTML = `
        <td>${d}/${m}/${y.slice(2)}</td>
        <td>${escapeHtml(t.description)}</td>
        <td><span class="cat-pill">${escapeHtml(t.category)}</span></td>
        <td class="num ${t.type}">${t.type==='in' ? '+' : '−'} ${brl.format(t.amount)}</td>
        <td><button class="del-btn" data-id="${t.id}" title="Excluir">✕</button></td>
      `;
      body.appendChild(tr);
    });
    body.querySelectorAll('.del-btn').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        transactions = transactions.filter(t=>t.id !== btn.dataset.id);
        saveData();
        renderAll();
      });
    });
  }

  function escapeHtml(str){
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderAll(){
    renderTabs();
    const list = filteredTransactions();
    renderSummary(list);
    renderChart(list);
    renderLedger(list);
  }

  // form handling
  const typeButtons = document.querySelectorAll('.type-toggle button');
  let currentType = 'out';
  typeButtons.forEach(btn=>{
    btn.addEventListener('click', ()=>{
      typeButtons.forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      currentType = btn.dataset.type;
    });
  });

  document.getElementById('entryForm').addEventListener('submit', function(e){
    e.preventDefault();
    const desc = document.getElementById('fDesc').value.trim();
    const amount = parseFloat(document.getElementById('fAmount').value);
    const category = document.getElementById('fCategory').value;
    const date = document.getElementById('fDate').value;

    if(!desc || !amount || amount <= 0 || !date) return;

    transactions.push({
      id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()+Math.random()),
      description: desc,
      amount: Math.round(amount*100)/100,
      category,
      date,
      type: currentType
    });
    saveData();
    e.target.reset();
    document.getElementById('fDate').value = new Date().toISOString().slice(0,10);
    typeButtons.forEach(b=>b.classList.remove('active'));
    document.querySelector('.type-toggle button[data-type="out"]').classList.add('active');
    currentType = 'out';
    renderAll();
  });

  // backup
  document.getElementById('exportBtn').addEventListener('click', ()=>{
    const blob = new Blob([JSON.stringify(transactions, null, 2)], { type:'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `balancete-backup-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('importBtn').addEventListener('click', ()=>{
    document.getElementById('importFile').click();
  });

  document.getElementById('importFile').addEventListener('change', (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = (ev)=>{
      try{
        const data = JSON.parse(ev.target.result);
        if(Array.isArray(data)){
          transactions = data;
          saveData();
          renderAll();
        }else{
          alert('Arquivo de backup inválido.');
        }
      }catch(err){
        alert('Não foi possível ler o arquivo de backup.');
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  // init
  populateCategorySelect();
  document.getElementById('fDate').value = new Date().toISOString().slice(0,10);
  renderAll();
})();
</script>
</body>
</html>
